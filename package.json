{
  "name": "smart-inventory-forecasting-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --names api,web --kill-others-on-fail \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "build:cloudflare": "VITE_BASE_PATH=/Smartinventoryforecastingsystem npm run build --prefix frontend",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "seed": "npm run seed --prefix backend"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "bcryptjs": "^3.0.3",
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "wrangler": "^4.116.0"
  }
}
