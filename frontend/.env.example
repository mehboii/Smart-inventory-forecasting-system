# Leave VITE_API_URL unset for local development: Vite proxies /api to the
# backend. Set this only when the frontend and API are deployed separately.
# VITE_API_URL=https://api.example.com/api

# Optional local proxy target (the default is http://127.0.0.1:4000).
# VITE_BACKEND_URL=http://127.0.0.1:4000
